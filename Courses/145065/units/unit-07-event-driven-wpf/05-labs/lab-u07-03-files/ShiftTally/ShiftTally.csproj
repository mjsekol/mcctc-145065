<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit 7, Week 14. The window half of ShiftTally. Everything it shows comes
    from TallyViewModel in ShiftTally.Core, through data binding.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>ShiftTally</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShiftTally.Core\ShiftTally.Core.csproj" />
  </ItemGroup>

</Project>
