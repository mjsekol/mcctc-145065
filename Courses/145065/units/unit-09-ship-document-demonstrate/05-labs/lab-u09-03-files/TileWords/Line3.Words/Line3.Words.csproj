<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Line3.Words: the practice panel's screen words, for Lab U09-03.
    The Version below is the release version. Change it on purpose, never
    by accident, and write the reason in CHANGELOG.md.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Line3.Words</RootNamespace>
    <Version>1.0.0</Version>
  </PropertyGroup>

</Project>
