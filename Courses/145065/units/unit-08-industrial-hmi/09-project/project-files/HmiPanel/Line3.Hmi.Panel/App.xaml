<Application x:Class="Line3.Hmi.Panel.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <!--
      No StartupUri. App.xaml.cs reads the command line and the thresholds
      file first, and only opens the window when both are good.
      Every style the panel uses lives in PanelView.xaml, so the screenshot
      harness can render the panel without this Application.
    -->
</Application>
